# Copy to .env and fill in the Meta Model API key.
# .env is gitignored; never commit real keys.

# Required for the Spark path. Sent to https://api.meta.ai/v1 (muse-spark-1.3).
# MODEL_API_KEY is accepted as a legacy alias.
META_API_KEY=

# Modal is authenticated separately:
#   uv run modal setup
# That writes ~/.modal.toml. Do not put Modal tokens in this file.
